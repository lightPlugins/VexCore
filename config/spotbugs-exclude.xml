<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Constructors deliberately reject invalid arguments; these classes do not use finalizers. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Paper mutates ItemStack and returns a status flag unknown to SpotBugs. -->
  <Match>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    <Class name="~dev\.vexsoft\.core\.paper\.(?:inventory|service\.inventory)\..*"/>
  </Match>
  <Match>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    <Class name="dev.vexsoft.core.paper.service.items.VexItemStackBuilder"/>
  </Match>
  <Match>
    <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    <Class name="dev.vexsoft.core.paper.level.menu.LevelMenuItems"/>
  </Match>

  <!-- Adventure Components are immutable values despite not being annotated for SpotBugs. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="dev.vexsoft.core.execution.ExecutionDescription"/>
      <Class name="dev.vexsoft.core.execution.TypedExecutionDescription"/>
    </Or>
  </Match>

  <!-- Framework contracts intentionally expose their managed runtime object. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Or>
      <Class name="dev.vexsoft.core.paper.VexCorePlugin"/>
      <!-- Placeholder contexts deliberately carry the managed VexPlayer for one resolution. -->
      <Class name="dev.vexsoft.core.placeholder.PlaceholderContext"/>
      <!-- Execution contexts deliberately carry the managed VexPlayer for one operation. -->
      <Class name="dev.vexsoft.core.execution.PlayerExecutionContext"/>
      <Class name="dev.vexsoft.core.paper.plugin.VexPlugin"/>
      <Class name="dev.vexsoft.core.paper.service.inventory.VexInventoryHolder"/>
    </Or>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="dev.vexsoft.core.common.configuration.ConfigurateConfigurationSection"/>
      <Class name="dev.vexsoft.core.paper.module.PacketModule"/>
      <Class name="dev.vexsoft.core.paper.localization.VexPlayerLanguageChangeEvent"/>
      <Class name="dev.vexsoft.core.execution.PlayerExecutionContext"/>
    </Or>
  </Match>

  <!-- The request stores an immutable Set.copyOf result. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Class name="dev.vexsoft.core.paper.packets.display.FakeItemDisplayRequest"/>
    <Method name="getLifecycle"/>
  </Match>

  <!-- PlaceholderAPI's expansion base class defines equality without a matching hash code. -->
  <Match>
    <Bug pattern="HE_INHERITS_EQUALS_USE_HASHCODE"/>
    <Class name="dev.vexsoft.core.paper.placeholder.VexPlaceholderExpansion"/>
  </Match>
</FindBugsFilter>
