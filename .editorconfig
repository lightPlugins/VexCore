root = true

[*.java]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true
ij_continuation_indent_size = 4
ij_java_keep_line_breaks = true
ij_java_keep_first_column_comment = false
ij_java_keep_blank_lines_in_declarations = 1
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_before_right_brace = 0
ij_java_blank_lines_after_class_header = 1
ij_java_blank_lines_around_method = 1
ij_java_blank_lines_around_method_in_interface = 1
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_method_parameters_wrap = chop_down_if_long
ij_java_call_parameters_wrap = chop_down_if_long
ij_java_method_parameters_new_line_after_left_paren = true
ij_java_method_parameters_right_paren_on_new_line = true
ij_java_call_parameters_new_line_after_left_paren = true
ij_java_call_parameters_right_paren_on_new_line = true
ij_java_method_call_chain_wrap = chop_down_if_long
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_lambdas_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_doc_do_not_wrap_one_line_comments = true
ij_java_enum_constants_wrap = on_every_item
ij_java_space_inside_one_line_enum_braces = true
ij_java_binary_operation_sign_on_next_line = true
ij_java_ternary_operation_signs_on_next_line = true
ij_java_imports_layout = $*,|,*
